#!/bin/bash

################################################################################
# GhostShell Mining Control Center
# Start/stop mining and manage wallet operations
################################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MINING_PID_FILE="${SCRIPT_DIR}/.mining.pid"
WALLET_DIR="${SCRIPT_DIR}/wallets"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Helper functions
print_header() {
    echo -e "${BLUE}╔════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC} $1"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════╝${NC}"
}

print_status() {
    echo -e "${GREEN}✅${NC} $1"
}

print_error() {
    echo -e "${RED}❌${NC} $1"
}

print_info() {
    echo -e "${CYAN}ℹ️${NC}  $1"
}

# Start mining
start_mining() {
    print_header "Starting Mining System"
    
    if [ -f "$MINING_PID_FILE" ]; then
        OLD_PID=$(cat "$MINING_PID_FILE")
        if kill -0 "$OLD_PID" 2>/dev/null; then
            print_error "Mining already running (PID: $OLD_PID)"
            return 1
        fi
    fi
    
    print_info "Initializing wallet..."
    python3 "${SCRIPT_DIR}/wallet_manager.py" init
    
    print_info "Launching mining orchestrator..."
    cd "${SCRIPT_DIR}"
    ./mine.sh > logs/mining_active.log 2>&1 &
    MINE_PID=$!
    echo "$MINE_PID" > "$MINING_PID_FILE"
    
    print_status "Mining system started (PID: $MINE_PID)"
    print_info "View logs: tail -f logs/mining_active.log"
    print_info "Dashboard: http://localhost:9002"
    
    return 0
}

# Stop mining
stop_mining() {
    print_header "Stopping Mining System"
    
    if [ ! -f "$MINING_PID_FILE" ]; then
        print_error "Mining not running (no PID file found)"
        return 1
    fi
    
    MINE_PID=$(cat "$MINING_PID_FILE")
    
    if ! kill -0 "$MINE_PID" 2>/dev/null; then
        print_error "Mining process not found (PID: $MINE_PID)"
        rm -f "$MINING_PID_FILE"
        return 1
    fi
    
    print_info "Shutting down mining (PID: $MINE_PID)..."
    kill "$MINE_PID" 2>/dev/null
    
    # Wait for graceful shutdown
    for i in {1..10}; do
        if ! kill -0 "$MINE_PID" 2>/dev/null; then
            break
        fi
        sleep 1
    done
    
    # Force kill if still running
    if kill -0 "$MINE_PID" 2>/dev/null; then
        print_info "Force killing mining process..."
        kill -9 "$MINE_PID" 2>/dev/null
    fi
    
    rm -f "$MINING_PID_FILE"
    print_status "Mining system stopped"
    
    return 0
}

# Get wallet balance
get_balance() {
    print_header "Wallet Balance"
    python3 "${SCRIPT_DIR}/wallet_manager.py" balance
}

# Deposit mining reward to wallet
deposit_funds() {
    local amount=$1
    
    if [ -z "$amount" ]; then
        print_error "Usage: mining_control deposit <amount>"
        return 1
    fi
    
    print_info "Depositing $amount BTC to wallet..."
    python3 "${SCRIPT_DIR}/wallet_manager.py" deposit "$amount" --source "mining_manual_deposit"
}

# Request withdrawal
request_withdrawal() {
    local amount=$1
    local address=$2
    local address_type=$3
    
    if [ -z "$amount" ] || [ -z "$address" ]; then
        print_error "Usage: mining_control withdraw <amount> <address> [address_type]"
        return 1
    fi
    
    address_type=${address_type:-"ethereum"}
    
    print_info "Requesting withdrawal..."
    python3 "${SCRIPT_DIR}/wallet_manager.py" withdraw "$amount" "$address" --type "$address_type"
}

# Confirm withdrawal
confirm_withdrawal() {
    local withdrawal_id=$1
    local tx_hash=$2
    
    if [ -z "$withdrawal_id" ] || [ -z "$tx_hash" ]; then
        print_error "Usage: mining_control confirm <withdrawal_id> <tx_hash>"
        return 1
    fi
    
    print_info "Confirming withdrawal..."
    python3 "${SCRIPT_DIR}/wallet_manager.py" confirm "$withdrawal_id" "$tx_hash"
}

# Get exchange rate
get_exchange_rate() {
    local crypto=${1:-bitcoin}
    print_info "Fetching exchange rate..."
    python3 "${SCRIPT_DIR}/wallet_manager.py" exchange --crypto "$crypto"
}

# View transaction history
view_history() {
    local limit=${1:-20}
    python3 "${SCRIPT_DIR}/wallet_manager.py" history --limit "$limit"
}

# Check mining status
check_status() {
    print_header "Mining System Status"
    
    if [ -f "$MINING_PID_FILE" ]; then
        MINE_PID=$(cat "$MINING_PID_FILE")
        if kill -0 "$MINE_PID" 2>/dev/null; then
            print_status "Mining is RUNNING (PID: $MINE_PID)"
            
            # Show process info
            echo ""
            echo "Process Details:"
            ps aux | grep "$MINE_PID" | grep -v grep | awk '{printf "  CPU: %s, Memory: %s\n", $3, $4}'
        else
            print_error "Mining process not found (PID file stale)"
            rm -f "$MINING_PID_FILE"
        fi
    else
        print_error "Mining is STOPPED"
    fi
    
    # Show wallet status
    echo ""
    get_balance
}

# Show dashboard menu
show_menu() {
    echo -e "${CYAN}"
    echo "╔════════════════════════════════════════════════════════╗"
    echo "║         GhostShell Mining Control Center              ║"
    echo "╠════════════════════════════════════════════════════════╣"
    echo "║                                                        ║"
    echo "║  MINING OPERATIONS:                                   ║"
    echo "║    start                    - Start mining            ║"
    echo "║    stop                     - Stop mining             ║"
    echo "║    status                   - Check status            ║"
    echo "║                                                        ║"
    echo "║  WALLET OPERATIONS:                                   ║"
    echo "║    balance                  - View wallet balance     ║"
    echo "║    deposit <amount>         - Deposit funds           ║"
    echo "║    withdraw <amt> <addr>    - Request withdrawal     ║"
    echo "║    confirm <id> <tx_hash>   - Confirm withdrawal     ║"
    echo "║    history [limit]          - View transactions       ║"
    echo "║    exchange [crypto]        - Get USD exchange rate   ║"
    echo "║                                                        ║"
    echo "║  SYSTEM:                                              ║"
    echo "║    help                     - Show this menu          ║"
    echo "║    exit                     - Exit control center     ║"
    echo "║                                                        ║"
    echo "╚════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

# Main menu loop
interactive_mode() {
    print_header "GhostShell Mining Control Center"
    
    while true; do
        echo ""
        echo -e "${CYAN}mining> ${NC}" | tr -d '\n'
        read -r command args
        
        case "$command" in
            start)
                start_mining
                ;;
            stop)
                stop_mining
                ;;
            status)
                check_status
                ;;
            balance)
                get_balance
                ;;
            deposit)
                deposit_funds $args
                ;;
            withdraw)
                request_withdrawal $args
                ;;
            confirm)
                confirm_withdrawal $args
                ;;
            history)
                view_history $args
                ;;
            exchange)
                get_exchange_rate $args
                ;;
            help)
                show_menu
                ;;
            exit|quit)
                print_info "Exiting mining control center..."
                break
                ;;
            "")
                continue
                ;;
            *)
                print_error "Unknown command: $command"
                show_menu
                ;;
        esac
    done
}

# Main script logic
main() {
    if [ $# -eq 0 ]; then
        # Interactive mode if no arguments
        interactive_mode
    else
        # Command mode
        case "$1" in
            start)
                start_mining
                ;;
            stop)
                stop_mining
                ;;
            status)
                check_status
                ;;
            balance)
                get_balance
                ;;
            deposit)
                deposit_funds "$2"
                ;;
            withdraw)
                request_withdrawal "$2" "$3" "$4"
                ;;
            confirm)
                confirm_withdrawal "$2" "$3"
                ;;
            history)
                view_history "$2"
                ;;
            exchange)
                get_exchange_rate "$2"
                ;;
            help)
                show_menu
                ;;
            *)
                print_error "Unknown command: $1"
                echo ""
                show_menu
                exit 1
                ;;
        esac
    fi
}

main "$@"
